{
  "build": {
    "distDir": "../src",
    "devPath": "../src",
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.openconv.app",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "OpenConv",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
